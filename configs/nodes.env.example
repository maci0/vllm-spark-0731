# Copy to nodes.env and fill QSFP RoCE fabric IPs (not the LAN/management IP).
# Verify interface: ip -4 addr show enp1s0f1np1
#
# Static configuration example:
# On head (spark1):   NODE_RANK=0  VLLM_HOST_IP=10.0.1.1  HEAD_IP=10.0.1.1
# On worker (spark2): NODE_RANK=1  VLLM_HOST_IP=10.0.1.2  HEAD_IP=10.0.1.1

HEAD_IP=10.0.1.1

# Dynamic dispatch template (matches hostname automatically):
case "$(hostname -s 2>/dev/null || hostname)" in
  spark1) VLLM_HOST_IP=10.0.1.1; NODE_RANK=0 ;;
  spark2) VLLM_HOST_IP=10.0.1.2; NODE_RANK=1 ;;
  *) echo "unknown host $(hostname), set VLLM_HOST_IP and NODE_RANK manually" >&2 ;;
esac

