# Same 0.28 image as pin.env, NVFP4 KV page (584 B DSV4). DSpark k=5 required.
# Real B/token saving needs a DSV4 NVFP4 CUDA writer in FlashInfer. This image
# does not vendor one. Capacity without that writer tracks fp8_ds_mla.

HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
HF_MODEL_REVISION=main
REQUIRED_ARCHITECTURE=DeepseekV4ForCausalLM
REQUIRED_MODEL_TYPE=deepseek_v4
REQUIRED_NAME_SUBSTRING=DeepSeek-V4-Flash-0731

IMAGE=vllm-spark-0731:v0.28.0rc2-b12x
STACK=nvfp4
VLLM_RELEASE=v0.28.0rc2
B12X_VERSION=1.2.6

KV_CACHE_DTYPE=nvfp4_ds_mla
MOE_BACKEND=b12x
LINEAR_BACKEND=
ATTENTION_BACKEND=

SPEC_METHOD=dspark
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic

BLOCK_SIZE=256
TP_SIZE=2
NNODES=2
PP_SIZE=1
SERVE_PORT=8000
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
MAX_CUDAGRAPH_CAPTURE_SIZE=36
LONG_PREFILL_TOKEN_THRESHOLD=1024
SERVED_MODEL_NAME="deepseek-v4-flash dsv4"
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4

CONTAINER_NAME=vllm-ds4-0731
