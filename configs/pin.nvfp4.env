# Active bring-up: b12x linear+MoE, nvfp4_ds_mla KV, DSpark k=5.
# FLASHINFER_MLA_SPARSE_DSV4 needs overlay patch_dsv4_nvfp4_attn or SM12x
# rejects this dtype. Page is 584 B (same packed layout as fp8_ds_mla).
# Real B/token saving needs a DSV4 NVFP4 CUDA writer. This image has none.

HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
HF_MODEL_REVISION=main
REQUIRED_ARCHITECTURE=DeepseekV4ForCausalLM
REQUIRED_MODEL_TYPE=deepseek_v4
REQUIRED_NAME_SUBSTRING=DeepSeek-V4-Flash-0731

IMAGE=vllm-spark-0731:v0.28.0rc2-b12x
STACK=nvfp4
VLLM_RELEASE=v0.28.0rc2
B12X_VERSION=1.2.6

KV_CACHE_DTYPE=nvfp4_ds_mla
MOE_BACKEND=b12x
# Explicit b12x linear. Real wq_a GEMM cosine 0.9999986 vs torch dequant.
# MXFP4 expert 0 cosine 0.99896 (w13_layout=w31). Keep b12x; do not switch to Triton.
LINEAR_BACKEND=b12x
ATTENTION_BACKEND=FLASHINFER_MLA_SPARSE_DSV4

SPEC_METHOD=dspark
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic

# Manager block must be a multiple of 128 (C128 storage = block_size/128).
# SWA pages are hardcoded 64. SM12x FlashInfer kernel is 64; vLLM splits
# 256-token manager blocks into 4 kernel pages.
BLOCK_SIZE="${BLOCK_SIZE:-256}"
TP_SIZE="${TP_SIZE:-2}"
NNODES="${NNODES:-2}"
PP_SIZE="${PP_SIZE:-1}"
SERVE_PORT="${SERVE_PORT:-8000}"
# spark2 earlyoom: SIGTERM at MemAvailable<8% (~10 GiB), prefers comm=vllm.
# 0.85 allocated 20 GiB KV then earlyoom SIGTERM'd the parent (docker exit 0).
# 0.80 finished graphs (478,419 tokens). 0.81 aims just above that.
# Raise again after `sudo swapon /swap.img` on spark2, or earlyoom -m raised.
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.81}"
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
# Isolation that landed: PIECEWISE + TP all-reduce eager-break, clone off
# the CUDA graph pool. DSpark graphs stay off. FULL still crashes/collapses.
# Fallback: ENFORCE_EAGER=1 (drop or ignore CUDAGRAPH_MODE).
ENFORCE_EAGER=0
CUDAGRAPH_MODE=PIECEWISE
MAX_CUDAGRAPH_CAPTURE_SIZE=36
LONG_PREFILL_TOKEN_THRESHOLD=1024
SERVED_MODEL_NAME="deepseek-v4-flash dsv4"
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4

CONTAINER_NAME=vllm-ds4-0731
