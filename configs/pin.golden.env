# Prebuilt anemll image. Real measured NVFP4 on 2x Spark (2026-08-22).
# Not the 0.28 cherry-pick image. DSpark k=5.

HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
HF_MODEL_REVISION=main
REQUIRED_ARCHITECTURE=DeepseekV4ForCausalLM
REQUIRED_MODEL_TYPE=deepseek_v4
REQUIRED_NAME_SUBSTRING=DeepSeek-V4-Flash-0731

IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
STACK=golden

KV_CACHE_DTYPE=nvfp4_ds_mla
MOE_BACKEND=flashinfer_b12x
LINEAR_BACKEND=
ATTENTION_BACKEND=

SPEC_METHOD=dspark
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic

BLOCK_SIZE=256
TP_SIZE=2
NNODES=2
PP_SIZE=1
SERVE_PORT=8000
GPU_MEMORY_UTILIZATION=0.82
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=36
LONG_PREFILL_TOKEN_THRESHOLD=1024
SERVED_MODEL_NAME="deepseek-v4-flash dsv4"
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4

CONTAINER_NAME=vllm-ds4-0731

# The serve script passes these with EMPTY defaults; the golden's vLLM
# (0.25.2.dev0) parses VLLM_USE_B12X_MOE via int() and dies on ''.
# Pin explicit values for the golden boot (b12x flags are no-ops here).
VLLM_USE_B12X_MOE=0
B12X_MOE_FORCE_A8=0
VLLM_USE_B12X_WO_PROJECTION=0
VLLM_USE_B12X_MHC=0
VLLM_USE_B12X_SPARSE_INDEXER=0
B12X_MLA_SM120_UNIFIED=0
