# Target pin for the vLLM main matched build (docs/PLAN-MAIN.md).
# Wired to scripts/05-serve.sh main. Test util 0.8.
# Base: nvidia/cuda:13.3.1-cudnn-devel-ubuntu24.04
# Compile NCCL (sm_121) + PyTorch release/2.14 (12.1a) + vLLM main.
# Host may stay 13.0 + cuda-compat-13-3. Do not pip cu132 / NGC torch.
# Git heads + cutlass 4.7.0, not vLLM cuda.txt 0.6.17 / 4.6.2.
# Quality first: nvfp4_ds_mla 584 B DSV4 envelope, InstantTensor, no LMCache.
# Attention is B12X_MLA_SPARSE (b12x compressed MLA on the 584 B page).
# GPU util stays 0.8 (save option). Do not raise spark2 to 0.85.

HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
HF_MODEL_REVISION=main
REQUIRED_ARCHITECTURE=DeepseekV4ForCausalLM
REQUIRED_MODEL_TYPE=deepseek_v4
REQUIRED_NAME_SUBSTRING=DeepSeek-V4-Flash-0731

IMAGE=vllm-spark-0731:main-b12x-028-rdma
STACK=main
VLLM_RELEASE=main
VLLM_REPO=https://github.com/vllm-project/vllm.git
VLLM_REF=2cf0a6915ce544dc493a0990f2ea38d81601128a

B12X_VERSION=1.2.6
B12X_REPO=https://github.com/local-inference-lab/b12x.git
B12X_REF=master
CUTLASS_DSL_VERSION=4.7.0
QUACK_KERNELS_VERSION=0.6.4

CUDA_VERSION=13.3.1
FINAL_BASE_IMAGE=nvidia/cuda:13.3.1-cudnn-devel-ubuntu24.04
BUILD_BASE_IMAGE=nvidia/cuda:13.3.1-cudnn-devel-ubuntu24.04
TORCH_REPO=https://github.com/pytorch/pytorch.git
TORCH_REF=release/2.14
TORCH_VERSION=2.14.0
TORCHVISION_REPO=https://github.com/pytorch/vision.git
TORCHVISION_REF=release/0.29
TORCHVISION_VERSION=0.29.0
TORCHAUDIO_VERSION=none
TRITON_VERSION=3.7.1
NCCL_REPO=https://github.com/NVIDIA/nccl.git
NCCL_VERSION=source
NCCL_NVCC_GENCODE="-gencode=arch=compute_121,code=sm_121"
PYTORCH_INDEX_URL=
TORCH_CUDA_ARCH_LIST=12.1a
MAX_JOBS_TORCH=8
MAX_JOBS=16
VLLM_PRESERVE_SM12X_TARGET=1
VLLM_ENABLE_CUDA_COMPATIBILITY=1
DG_JIT_USE_NVRTC=0
DEEPGEMM_REF=nv_dev
DEEPGEMM_COMMIT=a6b593d2826719dcf4892609af7b84ee23aaf32a
DEEPEP_REPO=https://github.com/deepseek-ai/DeepEP.git
DEEPEP_REF=main

FLASHINFER_REPO=https://github.com/flashinfer-ai/flashinfer.git
FLASHINFER_REF=main
INSTANTTENSOR_REPO=https://github.com/scitix/InstantTensor.git
INSTANTTENSOR_REF=main
FASTSAFETENSORS_REPO=https://github.com/foundation-model-stack/fastsafetensors.git
FASTSAFETENSORS_REF=main
LMCACHE_REPO=https://github.com/LMCache/LMCache.git
LMCACHE_REF=dev

TILELANG_VERSION=0.1.13
HUMMING_KERNELS_VERSION=0.1.13
APACHE_TVM_FFI_VERSION=0.1.12
TOKENSPEED_MLA_VERSION=0.2.5
NVIDIA_CUDA_NVDISASM_VERSION=13.3.73

KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-nvfp4_ds_mla}"
MOE_BACKEND=b12x
LINEAR_BACKEND=deep_gemm
ATTENTION_BACKEND=B12X_MLA_SPARSE
DRAFT_ATTENTION_BACKEND=B12X_MLA_SPARSE
LOAD_FORMAT=instanttensor
INSTANTTENSOR_DRAFT_LOADER=auto

SPEC_METHOD=dspark
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=greedy

BLOCK_SIZE="${BLOCK_SIZE:-256}"
TP_SIZE="${TP_SIZE:-2}"
NNODES="${NNODES:-2}"
PP_SIZE="${PP_SIZE:-1}"
SERVE_PORT="${SERVE_PORT:-8000}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.8}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-65536}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-32}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
ENFORCE_EAGER="${ENFORCE_EAGER:-0}"
CUDAGRAPH_MODE="${CUDAGRAPH_MODE:-FULL_AND_PIECEWISE}"
MAX_CUDAGRAPH_CAPTURE_SIZE="${MAX_CUDAGRAPH_CAPTURE_SIZE:-192}"
LONG_PREFILL_TOKEN_THRESHOLD=1024
SERVED_MODEL_NAME="deepseek-v4-flash dsv4"
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4
ENABLE_PREFIX_CACHING=1

# Persist inductor/AOT between serves.
VLLM_USE_AOT_COMPILE="${VLLM_USE_AOT_COMPILE:-1}"
B12X_MLA_SM120_UNIFIED="${B12X_MLA_SM120_UNIFIED:-1}"
B12X_MOE_FORCE_A8="${B12X_MOE_FORCE_A8:-1}"
VLLM_USE_B12X_WO_PROJECTION="${VLLM_USE_B12X_WO_PROJECTION:-1}"
VLLM_USE_B12X_MHC="${VLLM_USE_B12X_MHC:-1}"
VLLM_USE_B12X_MOE="${VLLM_USE_B12X_MOE:-1}"
VLLM_USE_B12X_SPARSE_INDEXER="${VLLM_USE_B12X_SPARSE_INDEXER:-1}"

# Phase 6: empty | lmcache | native. Default empty (quality pin has no offload).
# lmcache is the PLAN preference; native is OffloadingConnector FS if GDS/HMA fails.
KV_OFFLOAD="${KV_OFFLOAD:-}"
ENABLE_LMCACHE="${ENABLE_LMCACHE:-0}"

CONTAINER_NAME=vllm-ds4-0731

# deep_gemm stack requires the ue8m0 path: the a6 wheel's SF transform
# asserts on disable_ue8m0_cast=True (layout.hpp:49), and the packed-UE8M0
# activation scales are what the golden stack uses.
VLLM_USE_DEEP_GEMM_E8M0=1
