# Stack B (rollback). B12X_MLA_SPARSE with fp8 KV. Do not set nvfp4_ds_mla.
# Measured 2026-08-22: 1,768,024 KV tokens, 11,317 B/token.

HF_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
HF_MODEL_REVISION=main
REQUIRED_ARCHITECTURE=DeepseekV4ForCausalLM
REQUIRED_MODEL_TYPE=deepseek_v4
REQUIRED_NAME_SUBSTRING=DeepSeek-V4-Flash-0731

IMAGE=ghcr.io/spark-arena/dgx-vllm-eugr-nightly-b12x:2026081903
STACK=eugr

KV_CACHE_DTYPE=fp8_ds_mla
MOE_BACKEND=b12x
LINEAR_BACKEND=b12x
ATTENTION_BACKEND=B12X_MLA_SPARSE

SPEC_METHOD=dspark
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=probabilistic

BLOCK_SIZE=256
TP_SIZE=2
NNODES=2
PP_SIZE=1
SERVE_PORT=8000
GPU_MEMORY_UTILIZATION=0.89
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=64
LONG_PREFILL_TOKEN_THRESHOLD=
SERVED_MODEL_NAME="deepseek-v4-flash dsv4"
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
TOOL_CALL_PARSER=deepseek_v4

CONTAINER_NAME=vllm-ds4-0731
